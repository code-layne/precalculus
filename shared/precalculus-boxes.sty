\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{precalculus-boxes}[2026/06/01 Precalculus tcolorbox environments]

% Requires colors and tcolorbox; does NOT require apstats-article so that
% lesson-plan documents can set their own geometry independently.
\RequirePackage{precalculus-colors}
\RequirePackage[most]{tcolorbox}
\RequirePackage{needspace}
\RequirePackage{amsmath}   % \begin{aligned} inside the work environment
\tcbuselibrary{breakable, skins}

% ── \boxguard — the page-break guard ──────────────────────────────────────────
% THE BOXGUARD RULE: never let a box break leaving a ~1in sliver — a title plus
% a line or two — at the top or bottom of a page. If that little would print,
% push the WHOLE box to the next page. Breaking is fine only when each side of
% the break gets a substantial chunk.
%
% Put \boxguard on its own line immediately BEFORE \begin{...} of any breakable
% box. If fewer than 16 lines remain on the page, the box starts on the next one.
%
%   \boxguard
%   \begin{notesbox}{2. ...}
%
% Raise the count when a box OPENS with something unbreakable — a TikZ picture,
% an \fbox or a tabularx never splits, so the default guard can still strand a
% stub:
%
%   \boxguard[30]
%   \begin{notesbox}{3. ...}
%
% Prefer \boxguard over a hard \newpage — it self-adjusts when content above it
% changes. Reserve \newpage for "this box must start a page" instructions.
% Apply every guard to the blank AND its _key file; they stay in lockstep.
%
% Known limit: \boxguard is INERT inside a breakable tcolorbox — \needspace
% measures the outer page while tcolorbox splits its own assembled vbox
% afterwards. To force a split at a chosen point inside a breakable box, use
% tcolorbox's own \tcbbreak (unconditional — mirror it in blank and key).
\newcommand{\boxguard}[1][16]{\Needspace{#1\baselineskip}}

% ── \begin{work} … \end{work} — worked steps, one statement per line ──────────
% THE WORK RULE: a worked solution takes the SAME vertical space in the blank as
% it does in the key. The block below is authored ONCE and appears byte-identical
% in both files; the package swap decides only whether it is shipped.
%
%   precalculus-boxes (blank) → builds the box, ships a \vphantom of it, so the
%                               student gets exactly the room the answer needs
%                               and the PDF contains nothing (no ink, no text
%                               layer).
%   precalculus-key   (key)   → builds the same box and ships it, in keyred.
%
% Both branches build the box through the same code with the same formatting, so
% the metrics cannot drift. That is what retires the blank/key page mismatch —
% components stay the same length without anyone counting lines.
%
% Format rules (~/.claude/skills/lesson-planning/references/conventions.md — "The work rule"):
%   * ONE STATEMENT PER LINE. Never two steps on one row.
%   * The `&` goes immediately BEFORE the relation, so every relation in the
%     block lands in the same column.
%   * SIMPLIFYING — the first row is the original expression, the relation, and
%     the first simplification; each later row starts at the `&=` and aligns to
%     the one above:
%         \begin{work}
%           f(x) &= 3(x-2)^2 + 5 \\
%                &= 3x^2 - 12x + 17
%         \end{work}
%   * SOLVING — one row per step, every row aligned on its relation sign
%     (=, <, >, \le, \ge, \Rightarrow), including a reversal:
%         \begin{work}
%           2^{x+1} &= 32 \\
%             x + 1 &= 5 \\
%                 x &= 4
%         \end{work}
%
% Put the block where the student would work — after the prompt, before the next
% item. Do not wrap it in \[ \] or an align: it supplies its own display.
\newsavebox{\pc@work@box}
\newif\ifpc@workvisible \pc@workvisiblefalse
% Indent of the block from the left margin. Worked steps are set flush left, not
% centered like a display: the key should read as a column of work, and it is
% where the student writes theirs in the blank.
\newlength{\pc@workindent} \setlength{\pc@workindent}{2em}
% Extra leading between rows, on top of amsmath's \jot. 0pt sets the rows at
% typeset spacing — the key is compact and the blank reserves exactly that. Raise
% it (8–12pt) if students need handwriting room; it moves the blank and the key
% together, so the two can never drift apart.
\newlength{\workrowsep} \setlength{\workrowsep}{0pt}

\newenvironment{work}
  {\par\addvspace{\abovedisplayskip}%
   \begin{lrbox}{\pc@work@box}%
   \begin{minipage}{\linewidth}%
   \addtolength{\jot}{\workrowsep}%
   \color{keyred}\boldmath\bfseries
   \noindent\hspace*{\pc@workindent}%
   $\displaystyle\begin{aligned}}
  {\end{aligned}$%
   \end{minipage}%
   \end{lrbox}%
   \noindent
   \ifpc@workvisible
     \usebox{\pc@work@box}%
   \else
     % \vphantom ships an empty \null box carrying only the height and depth —
     % the content itself never reaches the page or the text layer.
     \vphantom{\usebox{\pc@work@box}}%
   \fi
   \par\addvspace{\belowdisplayskip}}

% ── Guided notes: the Main Ideas / Notes table ────────────────────────────────
% The guided-notes component is ONE two-column table — the "Main Ideas /
% Questions" column on the left, the "Notes" column on the right — modelled on
% the Algebra 2 guided-notes worksheets (ported from AP Statistics, 2026-09-12). Each ROW is one idea: a big label on the
% left, and on the right a terse definition with \blank{} fills, then a bold
% prompt and a GRID of short numbered problems with reserved work space. The
% teacher works the first problem or two of each grid (I do), the class works the
% rest with students holding the pen (we do); the last row is the Guided Practice.
% DENSITY — the page belongs to the student's pen, not to the author's prose:
%   * Printed text is SHORT and COMPLETE. A definition is one or two full
%     sentences the student reads, never a sentence with words punched out.
%   * A \blank{} appears only where a single word or number IS the answer (a
%     table to fill, a display to name). Never a mid-sentence blank ("the bars
%     ___"). Budget: a handful per lesson, not per row.
%   * Every row carries ONE pre-drawn display, set large; where the idea is a
%     picture, the student annotates it (\labelbox) instead of reading about it.
%   * Problems are TWO across, 12–18 per lesson, each with 2–3cm of answer
%     space; add a \writespace "In your own words" under a definition where
%     the idea deserves a restatement. Target 3–4 pages.
%
%   \begin{guidednotes}
%     \mainidea[Two kinds of]{Variable} &
%       A \textbf{discrete} variable takes a \blank{2cm} number of values.
%       \notesprompt{Classify each variable.}
%       \begin{probgrid}{|Y|Y|Y|}
%         \pcell{1}{Siblings}{1.3cm}{} & \pcell{2}{Height}{1.3cm}{} & \pcell{3}{Minutes}{1.3cm}{} \\ \hline
%       \end{probgrid}
%       \\ \hline
%     \mainidea{Guided practice} & ... \\ \hline
%   \end{guidednotes}
%
% Mechanics:
%   * The table is an xltabular (longtable + tabularx): it breaks BETWEEN rows
%     across pages by itself — no \boxguard, no \newpage. A row must fit on one
%     page, so keep each idea to well under a page; split a long idea into two rows.
%     The head prints once; every page after a break re-opens with the row's own
%     top rule, and the foot closes each page with a rule. Both columns are
%     m-columns, so the label sits vertically centred beside its notes.
%   * Every row ends `\\ \hline`. The first row after the head needs no top rule.
%   * \mainidea[lead]{Label} — the left cell: an optional small italic lead
%     ("Two kinds of") over the label, set bold sans in plum and UPPERCASED.
%   * \notesprompt{...} — the bold instruction line that introduces a grid.
%   * probgrid{colspec} — a nested grid flush with the row's rules; colspec is
%     a tabularx spec, |Y|Y| (two across — the default; three across only for
%     one-word answers). Rows end `\\ \hline`; the grid draws its own top rule.
%     Number problems continuously through the whole component, 1..N.
%     PACKING: a table row cannot break across pages, so put EACH grid row in
%     its own sub-row — close the probgrid, write `\\` and `& `, and open the
%     next one as probgrid* (starred: no top rule, so the two read as one grid).
%     The figure gets a sub-row of its own the same way. Then the table breaks
%     wherever it needs to and pages fill.
%   * \pcell{n}{statement}{H}{answer} — one grid cell: bold number, the statement
%     at its natural height, then the answer in keyred bold inside a FIXED-HEIGHT
%     box of H below it. The BLANK passes {} as the answer and the KEY passes the
%     answer text — that is the whole difference, and because H is fixed the two
%     files cannot drift (the work rule, applied to grid cells). Argument 4 is
%     TEXT MODE: wrap math in $...$. H is the ANSWER space only — size it to the
%     answer: 0.9cm for a word or a number, 1.2–1.6cm for a sentence or a short
%     computation (a keyred line is ~0.5cm). An answer longer than H overflows
%     the cell silently: keep key answers short.
%   * \stepnum{n} — a numbered step marker (white digit on a plum disc) for a
%     procedure listed in the Notes column: \stepnum{1}\ Choose an interval width.
%   * \writespace{H}{answer} — an open writing area of fixed height H, full cell
%     width, for the student's own sentence; the blank passes {} and the key
%     prints the answer in keyred. Same height both ways (the work rule). It is
%     the shared spelling of the per-file \answerspace that older homework
%     components define locally.
%   * \labelbox{W}{answer} — a small framed box of width W and fixed height for
%     annotating a display ("this display is a ___", an arrow's label); blank
%     passes {}, key passes the label. Use it beside or under a figure, with
%     \quad or a TikZ node, so the picture is what gets marked up.
%
% \pageheader, then the vocabbox, then ONE guidednotes table — that is the
% component. Objectives live on the cover; the notes do not repeat them.
\RequirePackage{xltabular}
\newlength{\mainideawidth} \setlength{\mainideawidth}{0.27\linewidth}
\newcommand{\mainidea}[2][]{%
  \begin{minipage}{\linewidth}\centering
    \ifx\relax#1\relax\else{\itshape\small #1}\\[3pt]\fi
    {\sffamily\bfseries\large\color{plum}\MakeUppercase{#2}}%
  \end{minipage}}
\newcommand{\notesprompt}[1]{\par\vspace{5pt}\noindent\textbf{#1}\par\vspace{3pt}}
\newcommand{\pcell}[4]{%
  {\raggedright\textbf{#1.}\ #2\par}%
  \noindent\begin{minipage}[t][#3][t]{\linewidth}\raggedright
    \vspace{2pt}{\color{keyred}\bfseries #4}%
  \end{minipage}}
\newcommand{\stepnum}[1]{\tikz[baseline=(c.base)]\node[circle, fill=plum, text=white,
  inner sep=1.2pt, minimum size=1.1em, font=\bfseries\scriptsize] (c) {#1};}
\newcommand{\writespace}[2]{\par\noindent
  \begin{minipage}[t][#1][t]{\linewidth}\raggedright\vspace{2pt}%
    \strut{\color{keyred}\bfseries #2}\end{minipage}\par}
\newcommand{\labelbox}[2]{\fbox{\begin{minipage}[c][0.75cm][c]{#1}\centering
  \strut{\color{keyred}\bfseries #2}\end{minipage}}}
\NewDocumentEnvironment{probgrid}{s m +b}
  {\par\noindent\renewcommand{\tabularxcolumn}[1]{p{##1}}%
   \makebox[\linewidth][l]{\hspace*{-\tabcolsep}%
   \begin{tabularx}{\dimexpr\linewidth+2\tabcolsep\relax}[b]{#2}
   \IfBooleanF{#1}{\hline}
   #3
   \end{tabularx}}\par}
  {}
\NewDocumentEnvironment{guidednotes}{+b}
  {\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}m{##1}}%
   \setlength{\LTpre}{6pt}\setlength{\LTpost}{6pt}%
   \begin{xltabular}{\linewidth}{|>{\centering\arraybackslash}m{\mainideawidth}|X|}
   \hline
   \multicolumn{1}{|c|}{\textbf{Main Ideas / Questions}} & \textbf{Notes} \\ \hline
   \endfirsthead
   \hline \endfoot
   \endlastfoot
   #1
   \end{xltabular}}
  {}

% ── Teacher notes ─────────────────────────────────────────────────────────────
% TEACHER NOTES LIVE IN THE LESSON PLAN, one per component, titled for it:
%
%   \begin{teachernote}[Warm-Up] ... \end{teachernote}   → "Teacher Note: Warm-Up"
%   \begin{teachernote}          ... \end{teachernote}   → "Teacher Note"
%
% They used to be appended to each _key, which made the key longer than its
% blank for no student-facing reason — the one block with no counterpart in the
% blank, and after the work rule the main thing still costing a packet blank
% pages. The lesson plan is teacher-facing already and sits outside the
% page-matched packet, so that is where the prose belongs.
%
% Defined here rather than in precalculus-key because the lesson plan loads
% -boxes only. The optional argument keeps every pre-existing bare
% \begin{teachernote} in an un-migrated key compiling unchanged.
\tcbset{teachernotestyle/.style={
    enhanced,
    colback=redbg, colframe=redacc, boxrule=0.7pt, arc=1.5mm,
    left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
    fonttitle=\bfseries\scriptsize\color{white},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=redacc, colframe=redacc, arc=1mm},
    breakable
}}
\NewDocumentEnvironment{teachernote}{o}
  {\begin{tcolorbox}[teachernotestyle,
      title={Teacher Note\IfValueT{#1}{: #1}}]}
  {\end{tcolorbox}}

% ── Lesson-plan box ───────────────────────────────────────────────────────────
% Usage: \begin{skillbox}[Title]{background-color} ... \end{skillbox}
\newtcolorbox{skillbox}[2][]{
    colback=#2, colframe=plum, boxrule=0.8pt, arc=2mm,
    left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
    fonttitle=\bfseries, title={#1}, halign title=center, breakable
}

% Like skillbox but does not break across pages.
\newtcolorbox{fixedskillbox}[2][]{
    colback=#2, colframe=plum, boxrule=0.8pt, arc=2mm,
    left=2mm, right=2mm, top=0.3mm, bottom=1mm,
    fonttitle=\bfseries, title={#1}, halign title=center
}

