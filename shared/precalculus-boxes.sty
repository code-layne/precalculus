\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{precalculus-boxes}[2026/06/01 Precalculus tcolorbox environments]

% Requires colors and tcolorbox; does NOT require apstats-article so that
% lesson-plan documents can set their own geometry independently.
\RequirePackage{precalculus-colors}
\RequirePackage[most]{tcolorbox}
\RequirePackage{needspace}
\RequirePackage{amsmath}   % \begin{aligned} inside the work environment
\tcbuselibrary{breakable, skins}

% ── \boxguard — the page-break guard ──────────────────────────────────────────
% THE BOXGUARD RULE: never let a box break leaving a ~1in sliver — a title plus
% a line or two — at the top or bottom of a page. If that little would print,
% push the WHOLE box to the next page. Breaking is fine only when each side of
% the break gets a substantial chunk.
%
% Put \boxguard on its own line immediately BEFORE \begin{...} of any breakable
% box. If fewer than 16 lines remain on the page, the box starts on the next one.
%
%   \boxguard
%   \begin{notesbox}{2. ...}
%
% Raise the count when a box OPENS with something unbreakable — a TikZ picture,
% an \fbox or a tabularx never splits, so the default guard can still strand a
% stub:
%
%   \boxguard[30]
%   \begin{notesbox}{3. ...}
%
% Prefer \boxguard over a hard \newpage — it self-adjusts when content above it
% changes. Reserve \newpage for "this box must start a page" instructions.
% Apply every guard to the blank AND its _key file; they stay in lockstep.
%
% Known limit: \boxguard is INERT inside a breakable tcolorbox — \needspace
% measures the outer page while tcolorbox splits its own assembled vbox
% afterwards. To force a split at a chosen point inside a breakable box, use
% tcolorbox's own \tcbbreak (unconditional — mirror it in blank and key).
\newcommand{\boxguard}[1][16]{\Needspace{#1\baselineskip}}

% ── \begin{work} … \end{work} — worked steps, one statement per line ──────────
% THE WORK RULE: a worked solution takes the SAME vertical space in the blank as
% it does in the key. The block below is authored ONCE and appears byte-identical
% in both files; the package swap decides only whether it is shipped.
%
%   precalculus-boxes (blank) → builds the box, ships a \vphantom of it, so the
%                               student gets exactly the room the answer needs
%                               and the PDF contains nothing (no ink, no text
%                               layer).
%   precalculus-key   (key)   → builds the same box and ships it, in keyred.
%
% Both branches build the box through the same code with the same formatting, so
% the metrics cannot drift. That is what retires the blank/key page mismatch —
% components stay the same length without anyone counting lines.
%
% Format rules (references/conventions.md — "The work rule"):
%   * ONE STATEMENT PER LINE. Never two steps on one row.
%   * The `&` goes immediately BEFORE the relation, so every relation in the
%     block lands in the same column.
%   * SIMPLIFYING — the first row is the original expression, the relation, and
%     the first simplification; each later row starts at the `&=` and aligns to
%     the one above:
%         \begin{work}
%           f(x) &= 3(x-2)^2 + 5 \\
%                &= 3x^2 - 12x + 17
%         \end{work}
%   * SOLVING — one row per step, every row aligned on its relation sign
%     (=, <, >, \le, \ge, \Rightarrow), including a reversal:
%         \begin{work}
%           2^{x+1} &= 32 \\
%             x + 1 &= 5 \\
%                 x &= 4
%         \end{work}
%
% Put the block where the student would work — after the prompt, before the next
% item. Do not wrap it in \[ \] or an align: it supplies its own display.
\newsavebox{\pc@work@box}
\newif\ifpc@workvisible \pc@workvisiblefalse
% Indent of the block from the left margin. Worked steps are set flush left, not
% centered like a display: the key should read as a column of work, and it is
% where the student writes theirs in the blank.
\newlength{\pc@workindent} \setlength{\pc@workindent}{2em}
% Extra leading between rows, on top of amsmath's \jot. 0pt sets the rows at
% typeset spacing — the key is compact and the blank reserves exactly that. Raise
% it (8–12pt) if students need handwriting room; it moves the blank and the key
% together, so the two can never drift apart.
\newlength{\workrowsep} \setlength{\workrowsep}{0pt}

\newenvironment{work}
  {\par\addvspace{\abovedisplayskip}%
   \begin{lrbox}{\pc@work@box}%
   \begin{minipage}{\linewidth}%
   \addtolength{\jot}{\workrowsep}%
   \color{keyred}\boldmath\bfseries
   \noindent\hspace*{\pc@workindent}%
   $\displaystyle\begin{aligned}}
  {\end{aligned}$%
   \end{minipage}%
   \end{lrbox}%
   \noindent
   \ifpc@workvisible
     \usebox{\pc@work@box}%
   \else
     % \vphantom ships an empty \null box carrying only the height and depth —
     % the content itself never reaches the page or the text layer.
     \vphantom{\usebox{\pc@work@box}}%
   \fi
   \par\addvspace{\belowdisplayskip}}

% ── Teacher notes ─────────────────────────────────────────────────────────────
% TEACHER NOTES LIVE IN THE LESSON PLAN, one per component, titled for it:
%
%   \begin{teachernote}[Warm-Up] ... \end{teachernote}   → "Teacher Note: Warm-Up"
%   \begin{teachernote}          ... \end{teachernote}   → "Teacher Note"
%
% They used to be appended to each _key, which made the key longer than its
% blank for no student-facing reason — the one block with no counterpart in the
% blank, and after the work rule the main thing still costing a packet blank
% pages. The lesson plan is teacher-facing already and sits outside the
% page-matched packet, so that is where the prose belongs.
%
% Defined here rather than in precalculus-key because the lesson plan loads
% -boxes only. The optional argument keeps every pre-existing bare
% \begin{teachernote} in an un-migrated key compiling unchanged.
\tcbset{teachernotestyle/.style={
    enhanced,
    colback=redbg, colframe=redacc, boxrule=0.7pt, arc=1.5mm,
    left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
    fonttitle=\bfseries\scriptsize\color{white},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=redacc, colframe=redacc, arc=1mm},
    breakable
}}
\NewDocumentEnvironment{teachernote}{o}
  {\begin{tcolorbox}[teachernotestyle,
      title={Teacher Note\IfValueT{#1}{: #1}}]}
  {\end{tcolorbox}}

% ── Lesson-plan box ───────────────────────────────────────────────────────────
% Usage: \begin{skillbox}[Title]{background-color} ... \end{skillbox}
\newtcolorbox{skillbox}[2][]{
    colback=#2, colframe=plum, boxrule=0.8pt, arc=2mm,
    left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
    fonttitle=\bfseries, title={#1}, halign title=center, breakable
}

% Like skillbox but does not break across pages.
\newtcolorbox{fixedskillbox}[2][]{
    colback=#2, colframe=plum, boxrule=0.8pt, arc=2mm,
    left=2mm, right=2mm, top=0.3mm, bottom=1mm,
    fonttitle=\bfseries, title={#1}, halign title=center
}

