% ── Fill-in helpers ───────────────────────────────────────────────────────────
\newcommand{\blank}[1]{\underline{\hspace{#1}}}
\newcommand{\writeline}{\vspace{1pt}\noindent\textcolor{linegray}{\hrulefill}\vspace{3pt}}
\newcommand{\writelines}[1]{\foreach \i in {1,...,#1}{\writeline\\}}
% Graded answer lines (math-shared grading.sty), for a box drawn as written (a
% short box; choice and rubric boxes are resized, so they use \rubricbox below
% or sit unsmashed). A run of \writeline rules that a
% \gradedblank box replaces keeps its exact vertical footprint, so nothing after
% it moves: each rule but the last becomes \writegap (the same line, no rule),
% and the last becomes \writebox{\gradedblank[...]{\linewidth}{H}}, which stands
% the box on that line's baseline and reaches H up over the gaps above it. The
% box takes no space of its own; choose H to fill the area the rules filled.
\newcommand{\writegap}{\vspace{1pt}\noindent\hfill\vspace{3pt}}
\newcommand{\writebox}[1]{\vspace{1pt}\noindent
  \sbox0{#1}\smash{\raisebox{\dp0}{\usebox0}}\hfill\vspace{3pt}}
% A graded box that takes its full drawn size (math-shared draws a choice box
% square and a rubric box at least 2in tall, whatever height is written, so a
% box that size can no longer be smashed onto a line or laid over write-lines).
% \rubricbox[gap]{\gradedblank[type=rubric,...]{\linewidth}{H}} puts the box on
% its own line under its prompt, gap (default 3pt) below the prompt's last line,
% and never lets a page break fall between the two. The box stands on the
% line's baseline (no depth), so all of it counts toward the page and none of
% it can hang into the bottom margin. A choice box sits unsmashed after
% "Letter:", so its line grows to hold it.
\newcommand{\rubricbox}[2][3pt]{\par\nopagebreak\vspace{#1}\nopagebreak
  \noindent\sbox0{#2}\raisebox{\dp0}{\usebox0}\par}
% On a graded page (one that loads grading.sty) no paragraph leaves its first
% or last line alone at a page break. \rubricbox keeps a box with the last
% line of its prompt; this keeps that line with the rest of a two- or
% three-line prompt, so a question is never split from its box.
\newcommand{\gradedpagepenalties}{\clubpenalty=10000 \widowpenalty=10000
  \displaywidowpenalty=10000 \csname @clubpenalty\endcsname=10000 }
\@ifpackageloaded{grading}{\gradedpagepenalties}
  {\AddToHook{package/grading/after}{\gradedpagepenalties}}
\newcommand{\termblank}[1]{%
  \noindent\textbf{\textcolor{plum}{#1:}}\quad\blank{6.5cm}\\[1pt]%
  \writeline\\[2pt]}
% VOCABPAR: the \noindent below is a NO-OP mid-paragraph, so a vocabbox that opens
% with an intro sentence runs that sentence into the first term. Fix it per-lesson
% (\par\vspace{2pt} after the intro, in the blank AND the key), not here — patching
% it would re-flow every already-verified lesson. See ~/.claude/skills/lesson-planning/references/conventions.md and LESSON_SHAPE.md §4.
\newcommand{\termblanklong}[1]{%
  \noindent\textbf{\textcolor{plum}{#1:}}\\[1pt]%
  \writeline\\[1pt]\writeline\\[3pt]}

% ── Page header: \pageheader{Unit X, Lesson Y.Z}{Document Type} ───────────────
% Produces the full-width plum colorbox header used on all student documents.
\newcommand{\pageheader}[2]{%
    \noindent
    \colorbox{plum}{%
        \parbox{\dimexpr\linewidth}{%
            \vspace{6pt}%
            \color{white}\textbf{\large Precalculus \hfill #1}\\[2pt]%
            {\color{lilacmid}\small\textbf{#2}}%
            \vspace{6pt}%
        }%
    }%
    \vspace{1.5em}\par\noindent}

% ── Student name rows ─────────────────────────────────────────────────────────
% NAMESTRIP: these belong on the COVER (and on ungraded unit tests) only. The
% packet is stapled behind its cover, so a name row on every component costs
% vertical space at the top of each page for something the student already wrote
% on page 1 — space that matters most on the warm-up and exit ticket, held to one
% page. A GRADED component (one that loads grading.sty: ap_practice, printed
% homework, every graded test and quiz) never carries one: its pages are scanned
% and sent to an outside API, so they hold only the tracking id, and the name goes
% on math-shared's roster cover sheet. Strip them from components with
% scripts/namestrip.py, blank and key together.
\newcommand{\namedateperiod}{%
    \begin{tabularx}{\linewidth}{X X X}
    Name:\;\blank{4.8cm} & Date:\;\blank{2.8cm} & Period:\;\blank{1.5cm}
    \end{tabularx}}

\newcommand{\namepartnerperiod}{%
    \begin{tabularx}{\linewidth}{X X X}
    Name:\;\blank{4.8cm} & Partner:\;\blank{4.0cm} & Period:\;\blank{1.5cm}
    \end{tabularx}}
