\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{precalculus-article}[2026/06/01 Precalculus article preamble]

\RequirePackage[margin=0.75in, top=0.6in, bottom=0.75in]{geometry}
\RequirePackage{precalculus-colors}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{multicol}
\RequirePackage{amsmath,amssymb}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{tikz}
\RequirePackage{colortbl}
\RequirePackage{booktabs}

\tcbuselibrary{breakable, skins}

% ── Column types ──────────────────────────────────────────────────────────────
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\centering\arraybackslash}X}

% ── List / paragraph settings ─────────────────────────────────────────────────
\setlist[itemize]{leftmargin=1.2em, itemsep=0.3em, topsep=0.3em}
\setlist[enumerate]{leftmargin=1.5em, itemsep=0.4em, topsep=0.3em}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}

% ── Fill-in helpers ───────────────────────────────────────────────────────────
\newcommand{\blank}[1]{\underline{\hspace{#1}}}
\newcommand{\writeline}{\vspace{1pt}\noindent\textcolor{linegray}{\hrulefill}\vspace{3pt}}
\newcommand{\writelines}[1]{\foreach \i in {1,...,#1}{\writeline\\}}
\newcommand{\termblank}[1]{%
  \noindent\textbf{\textcolor{plum}{#1:}}\quad\blank{6.5cm}\\[1pt]%
  \writeline\\[2pt]}
% VOCABPAR: the \noindent below is a NO-OP mid-paragraph, so a vocabbox that opens
% with an intro sentence runs that sentence into the first term. Fix it per-lesson
% (\par\vspace{2pt} after the intro, in the blank AND the key), not here — patching
% it would re-flow every already-verified lesson. See references/conventions.md.
\newcommand{\termblanklong}[1]{%
  \noindent\textbf{\textcolor{plum}{#1:}}\\[1pt]%
  \writeline\\[1pt]\writeline\\[3pt]}

% ── Page header: \pageheader{Unit X, Lesson Y.Z}{Document Type} ───────────────
% Produces the full-width plum colorbox header used on all student documents.
\newcommand{\pageheader}[2]{%
    \noindent
    \colorbox{plum}{%
        \parbox{\dimexpr\linewidth}{%
            \vspace{6pt}%
            \color{white}\textbf{\large Precalculus \hfill #1}\\[2pt]%
            {\color{lilacmid}\small\textbf{#2}}%
            \vspace{6pt}%
        }%
    }%
    \vspace{1.5em}\par\noindent}

% ── Student name rows ─────────────────────────────────────────────────────────
% NAMESTRIP: these belong on the COVER (and on unit tests) only. The packet is
% stapled behind its cover, so a name row on every component costs vertical space
% at the top of each page for something the student already wrote on page 1 —
% space that matters most on the warm-up and exit ticket, held to one page.
% Strip them from components with scripts/namestrip.py, blank and key together.
\newcommand{\namedateperiod}{%
    \begin{tabularx}{\linewidth}{X X X}
    Name:\;\blank{4.8cm} & Date:\;\blank{2.8cm} & Period:\;\blank{1.5cm}
    \end{tabularx}}

\newcommand{\namepartnerperiod}{%
    \begin{tabularx}{\linewidth}{X X X}
    Name:\;\blank{4.8cm} & Partner:\;\blank{4.0cm} & Period:\;\blank{1.5cm}
    \end{tabularx}}
