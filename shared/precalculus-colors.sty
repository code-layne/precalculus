\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{precalculus-colors}[2026/08/03 Precalculus shared color palette]

\RequirePackage{xcolor}

% ── Primary palette — plum based ──────────────────────────────────────────────
% Plum is the course's primary accent (frames, page headers, banners, titles);
% lilac is its pale companion background.
\definecolor{plum}{HTML}{4B2A6C}
\definecolor{plumlight}{HTML}{6E4699}
\definecolor{lilac}{HTML}{F4EFFA}
\definecolor{lilacmid}{HTML}{DCCCEE}

% ── Accent families ───────────────────────────────────────────────────────────
\definecolor{goldacc}{HTML}{D4820A}
\definecolor{goldbg}{HTML}{FEF3E2}
\definecolor{hookbg}{HTML}{FEF3E2}
\definecolor{greenbg}{HTML}{EDF8F0}
\definecolor{greenacc}{HTML}{2D7A4F}
\definecolor{redbg}{HTML}{FCECEC}
\definecolor{redacc}{HTML}{C0392B}
\definecolor{charcoal}{HTML}{2C3E50}
\definecolor{slate}{HTML}{64748B}
\definecolor{linegray}{HTML}{AAAAAA}
\definecolor{keyred}{HTML}{CC0000}

% ── Lesson-plan background aliases ────────────────────────────────────────────
\definecolor{goldbox}{HTML}{FFF7E6}
\colorlet{greenbox}{greenbg}
\colorlet{redbox}{redbg}
\colorlet{plumbox}{lilac}

% ── Deprecated aliases ────────────────────────────────────────────────────────
% The palette's dominant color was formerly navy (inherited from the statistics
% course); these keep older references working. Prefer the plum/lilac names
% above in new material.
\colorlet{navy}{plum}
\colorlet{navylight}{plumlight}
\colorlet{sky}{lilac}
\colorlet{skymid}{lilacmid}
