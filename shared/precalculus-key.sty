\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{precalculus-key}[2026/06/01 Precalculus answer-key additions]

\RequirePackage{precalculus-boxes}

% ── The work rule ─────────────────────────────────────────────────────────────
% \begin{work} is defined in precalculus-boxes and is authored identically in the
% blank and the key. The blank reserves the block's exact height and ships
% nothing; loading this package is what makes the same block visible. See the
% comment above the environment in precalculus-boxes.sty.
\pc@workvisibletrue

% ── Answer macros ─────────────────────────────────────────────────────────────
% \ans{text}      — inline answer (colored bold); replaces blanks or write lines
% \ansline{text}  — answer that fills a full write line with a dotted trail
\newcommand{\ans}[1]{\textcolor{keyred}{\textbf{#1}}}
\newcommand{\ansline}[1]{%
    \vspace{1pt}\noindent\textcolor{keyred}{\textbf{#1}}%
    \textcolor{linegray}{\dotfill}\vspace{3pt}}

% ── Component identification table (key version) ──────────────────────────────
% Usage: \componenttablekey{individual}{population}{sample}{variable(s)}
\newcommand{\componenttablekey}[4]{%
    \renewcommand{\arraystretch}{1.8}%
    \begin{tabularx}{\linewidth}{@{} >{\bfseries\color{plum}}p{0.22\linewidth} X @{}}
    Individual:  & \ans{#1} \\
    Population:  & \ans{#2} \\
    Sample:      & \ans{#3} \\
    Variable(s): & \ans{#4} \\
    \end{tabularx}}

